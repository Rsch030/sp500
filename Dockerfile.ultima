FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN dpkg --add-architecture i386 && apt-get update && apt-get install -y --no-install-recommends xvfb xauth curl ca-certificates unzip python3 python3-venv fonts-liberation \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://dl.winehq.org/wine-builds/winehq.key -o /etc/apt/keyrings/winehq-archive.key \
    && curl -fsSL https://dl.winehq.org/wine-builds/ubuntu/dists/noble/winehq-noble.sources -o /etc/apt/sources.list.d/winehq-noble.sources \
    && apt-get update && apt-get install -y --no-install-recommends winehq-stable=11.0.0.0~noble-1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN python3 -m venv /opt/bridge-venv && /opt/bridge-venv/bin/pip install --no-cache-dir -r requirements.txt
RUN mkdir -p /opt/installers && curl -fL --retry 3 https://www.python.org/ftp/python/3.12.10/python-3.12.10-embed-amd64.zip -o /opt/installers/python.zip && curl -fL --retry 3 https://bootstrap.pypa.io/get-pip.py -o /opt/installers/get-pip.py && curl -fL --retry 3 https://download.terminal.free/cdn/web/ftmo.global.markets/mt5/ftmo5setup.exe -o /opt/installers/ftmo5setup.exe
COPY bot.py ftmo_guard.py ultima_runtime.py ultima_health.py ultima_probe.py ./
COPY mt5_bridge ./mt5_bridge
COPY UltimaGold.mq5 /app/UltimaGold.mq5
ENV DISPLAY=:99 WINEARCH=win64 WINEPREFIX=/tmp/wine WINEDEBUG=-all WINEDLLOVERRIDES=mscoree,mshtml=d DATA_DIR=/tmp/bridge-import RUNTIME_STATE=/data/runtime-state.json PYTHONUNBUFFERED=1
RUN WINEPREFIX=/opt/wine-seed BOOTSTRAP_ONLY=1 /opt/bridge-venv/bin/python -m mt5_bridge.wine_runtime
CMD ["/opt/bridge-venv/bin/python", "/app/ultima_runtime.py"]
